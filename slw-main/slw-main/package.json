{
  "name": "socionics-wheel-balance",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "typecheck": "tsc --noEmit",
    "types:api": "openapi-typescript ./scripts/openapi.json -o src/types/api.ts",
    "test:lite:unit": "vitest run --config vitest.config.ts",
    "test:lite:e2e": "playwright test --config playwright.config.ts",
    "test:lite:list": "playwright test --config playwright.config.ts --list"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^25.8.0",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.1",
    "gh-pages": "^6.1.1",
    "hyperframes": "^0.8.40",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.3",
    "vite": "^5.4.2",
    "vitest": "^2.1.9"
  }
}
